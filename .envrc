use flake
eval "$shellHook"

export SOPS_AGE_KEY_FILE="$(pwd)/deploy-keys.txt"

watch_file secrets.yaml
if [[ -f secrets.yaml ]]; then
  # Export every decrypted key, so new secrets need no matching entry in flake.nix.
  set -a
  eval "$(sops -d --output-type dotenv secrets.yaml 2>/dev/null)"
  set +a
fi
