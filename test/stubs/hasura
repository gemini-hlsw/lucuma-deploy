#!/usr/bin/env bash
# Fake hasura CLI for the tests. Logs the working directory with each call so the tests can check
# that it ran inside the lucuma-apps checkout. STUB_HASURA_PENDING=0 reports every migration as
# applied, so a run with no other change has nothing to promote.
set -euo pipefail
if [ -n "${STUB_LOG:-}" ]; then echo "$PWD :: $*" >> "$STUB_LOG/hasura.log"; fi
[[ " $* " == *" --endpoint "* ]] || { echo "stub hasura: missing --endpoint" >&2; exit 1; }
case "${1:-} ${2:-}" in
  "migrate status")
    echo "VERSION        NAME          SOURCE STATUS  DATABASE STATUS"
    echo "1700000000000  init          Present        Present"
    if [ "${STUB_HASURA_PENDING:-1}" = 0 ]; then
      echo "1792331515894  add_prefs     Present        Present"
    else
      echo "1792331515894  add_prefs     Present        Not Present"
    fi
    ;;
  "metadata diff")
    echo "Metadata is consistent"
    ;;
  "migrate apply")
    echo "INFO migrations applied"
    ;;
  "metadata apply")
    echo "INFO Metadata applied"
    ;;
  "metadata reload")
    echo "INFO Metadata reloaded"
    ;;
  *)
    echo "stub hasura: unexpected command: $*" >&2
    exit 1
    ;;
esac
